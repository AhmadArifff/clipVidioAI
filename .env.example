# ============================================================
# CLIPVIDIO AI — Environment Variables Template (.env.example)
# ============================================================
# IMPORTANT SECURITY NOTICE:
# - NEVER commit your actual .env file or real secrets to Git.
# - Copy this file to .env or backend/.env and fill in your keys.
# - The .env file is already excluded in .gitignore.
# ============================================================

# ── 1. Google Gemini API Keys ─────────────────────────────────
# Get a free API key at: https://aistudio.google.com/
# Single key:
# GEMINI_API_KEY=your_gemini_api_key_here
# Multiple keys for automatic dynamic quota rotation (comma-separated):
# GEMINI_API_KEYS=key1,key2,key3

# ── 2. OpenRouter API Key ─────────────────────────────────────
# Allows access to DeepSeek V3/R1, LLaMA 3.3, Claude 3.5, GPT-4o mini, etc.
# Get an API key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# ── 3. Supadata API Keys (YouTube Transcript Fallback) ───────
# Provides cloud residential proxying for YouTube transcripts.
# Multiple keys can be comma-separated for round-robin rotation.
# Get free keys (100 credits/mo each) at: https://supadata.ai/
# SUPADATA_API_KEYS=sd_key1,sd_key2,sd_key3

# ── 4. Webshare Rotating Proxy (Datacenter IP Unban) ─────────
# Prevents YouTube IP bans (IpBlocked / RequestBlocked).
# Register at: https://www.webshare.io/
# WEBSHARE_USERNAME=your_webshare_username
# WEBSHARE_PASSWORD=your_webshare_password
# WEBSHARE_LOCATIONS=US,GB,DE
# WEBSHARE_RETRIES=5

# Alternatively, specify a full proxy URL:
# PROXY_URL=http://your_user:your_pass@proxy_host:port
# WEBSHARE_PROXY=http://your_user-rotate:your_pass@p.webshare.io:80

# ── 5. System & Rendering Options (Optional) ──────────────────
# Path to custom CA bundle if running behind SSL inspection proxy:
# REQUESTS_CA_BUNDLE=/path/to/cacert.pem

# Path to custom color emoji font (.ttf / .otf):
# EMOJI_FONT_PATH=/path/to/NotoColorEmoji.ttf
